{
  "manifest_version": 3,
  "name": "PageNest Web Collector",
  "version": "1.10.0",
  "description": "提取网页正文和图片，保存为 Obsidian 单文件离线页面，并可选使用 OpenAI 兼容接口整理。",
  "permissions": ["activeTab", "scripting", "storage", "clipboardWrite"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*", "<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "capture-video-notebook-frame": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y"
      },
      "description": "Capture the visible video frame to the active Video Notebook"
    }
  },
  "content_scripts": [{
    "matches": ["https://*.xiaohongshu.com/*"],
    "js": ["adapters/xiaohongshu-video-observer.js"],
    "run_at": "document_start"
  }],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "保存到 Obsidian",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
