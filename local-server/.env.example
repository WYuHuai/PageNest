# Required: absolute path to your Obsidian vault.
OBSIDIAN_VAULT_PATH=

# Required: at least 24 random characters. Enter the same value in the browser extension.
LOCAL_COLLECTOR_TOKEN=

# Optional OpenAI-compatible organizer. These can also be configured in the extension.
HERMES_API_URL=
HERMES_MODEL_NAME=
HERMES_API_KEY=
